<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/etWheightMain"
        android:layout_width="579dp"
        android:layout_height="317dp"
        android:layout_marginStart="625dp"
        android:layout_marginTop="340dp"
        android:layout_marginEnd="1083dp"
        android:layout_marginBottom="308dp"
        android:ems="10"
        android:hint="weight..."
        android:inputType="text"
        android:text="weight..."
        app:layout_constraintBottom_toTopOf="@+id/etHeightMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etHeightMain"
        android:layout_width="580dp"
        android:layout_height="220dp"
        android:layout_marginStart="653dp"
        android:layout_marginTop="286dp"
        android:layout_marginEnd="1054dp"
        android:layout_marginBottom="1764dp"
        android:ems="10"
        android:hint="height..."
        android:inputType="text"
        android:text="Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etWheightMain" />

    <Button
        android:id="@+id/btnCalculateMain"
        android:onClick="calculate"
        android:layout_width="774dp"
        android:layout_height="436dp"
        android:layout_marginStart="726dp"
        android:layout_marginTop="397dp"
        android:layout_marginEnd="1088dp"
        android:layout_marginBottom="998dp"
        android:text="Calculate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etHeightMain" />
</androidx.constraintlayout.widget.ConstraintLayout>